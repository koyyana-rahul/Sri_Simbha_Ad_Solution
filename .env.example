# ---------------------------------------------------------------------------
# Public environment variables (Create React App).
#
# Copy this file to `.env.local` and adjust. Only variables prefixed with
# REACT_APP_ are exposed to the browser bundle.
#
# NEVER put a secret, API key or private token in this file — everything here
# is shipped to the browser in plain text.
# ---------------------------------------------------------------------------

# Canonical origin of the deployed site. Used for canonical URLs, Open Graph
# tags and the sitemap. No trailing slash.
REACT_APP_SITE_URL=https://simbha.vercel.app

# WhatsApp number in international format, digits only, no "+" and no spaces.
# Defaults to 918790359681 when unset.
REACT_APP_WHATSAPP_NUMBER=918790359681
